# ==============================================================================
# SIT STUDENTS HOSPITAL — SECURITY & BLOCKCHAIN ENVIRONMENT CONFIGURATION
# Run "npm run setup" to automatically generate a secure .env file.
# NEVER commit your real .env file to GitHub!
# ==============================================================================

PORT=3000
NODE_ENV=development

# Set DEMO_MODE=true ONLY for local academic viva presentations with synthetic data.
# Keep DEMO_MODE=false for security audits and live deployments.
DEMO_MODE=false
ALLOW_PUBLIC_DEMO=false

# Required Cryptographic Secrets (32+ random chars; ENCRYPTION_KEY must be 64 hex chars / 32 bytes)
JWT_SECRET=replace-with-64-hex-chars-from-npm-run-setup
SHARE_JWT_SECRET=replace-with-different-64-hex-chars-from-npm-run-setup
ENCRYPTION_KEY=replace-with-64-hex-chars-32-bytes-aes-256-gcm-key

# Used only to decrypt legacy v1 AES-256-CBC fixture files prior to running "npm run migrate:encryption"
LEGACY_ENCRYPTION_KEY=med-blockchain-sec-key-32bytes!

# Bootstrap Non-Demo Hospital Admin (used on first boot when DEMO_MODE=false; password must be >= 12 chars)
BOOTSTRAP_ADMIN_EMAIL=admin@sithospital.org
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisAdminPass!2026

# Real Ethereum EVM Blockchain Connection (e.g. Ethereum Sepolia Testnet via Alchemy / Infura)
# Run "npm run deploy:blockchain" after setting RPC URL & Private Key to deploy SITStudentsHospitalLedger.sol
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_NETWORK_NAME=Ethereum Sepolia Testnet
BLOCKCHAIN_EXPLORER_URL=https://sepolia.etherscan.io

# Hosting & Security Controls
CORS_ORIGINS=
TRUST_PROXY=false

# Optional Cloud AI Summarization (disabled by default to protect patient privacy)
AI_EXTERNAL_PROCESSING=false
GEMINI_API_KEY=

# Persistent Cloud Storage via Firebase (Free Spark Firestore — survives Render restarts/sleeps)
# Provide ONE of BASE64 (recommended for Render), raw JSON, or local file PATH
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
# Optional: set only if you upgrade Firebase to Blaze and enable a Cloud Storage bucket
FIREBASE_STORAGE_BUCKET=
